# Public Supabase project connection. Never place a secret key in NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for seed/setup tooling and the organizer Telegram bot. Never expose it.
SUPABASE_SECRET_KEY=
# Canonical URL, also used for OAuth callback construction.
SITE_URL=http://localhost:3000
# Only enable after GitHub is configured in Supabase Auth.
GITHUB_AUTH_ENABLED=false
# Apps Script web app that appends join applications to the membership sheet.
MEMBERSHIP_SHEET_URL=
# Organizer Telegram bot: token from @BotFather, a random webhook secret, and the chat IDs allowed to use it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_IDS=
