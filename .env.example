MAIL_FROM=
MAIL_TO=krowdkraft.official@gmail.com
RESEND_API_KEY=
SMTP_URL=
# Set only behind a trusted proxy that replaces x-forwarded-for.
TRUST_PROXY=false
# Optional absolute canonical URL for metadata, without trailing slash.
SITE_URL=
# Enable after the existing GA4 stream's automatic tracking settings are updated.
GOOGLE_ANALYTICS_ENABLED=false
# Existing KrowdKraft Supabase project. Keys are server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Comma-separated immutable Supabase Auth user IDs for organizers.
COMMUNITY_ADMIN_USER_IDS=
# Optional separate secret for hashing abuse-prevention identifiers.
SUBMISSION_HASH_SECRET=
# Optional GitHub token to increase public API quota. No private repo access needed.
GITHUB_PUBLIC_TOKEN=
