{
  "name": "krowdkraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "node scripts/figures/build.mjs",
    "prebuild": "node scripts/figures/build.mjs",
    "pretypecheck": "node scripts/figures/build.mjs",
    "figures:build": "node scripts/figures/build.mjs",
    "figures:validate": "npm run figures:build && node scripts/figures/validate.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "event:validate": "tsx scripts/events/validate.ts"
  },
  "dependencies": {
    "next": "^16.4.0",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
