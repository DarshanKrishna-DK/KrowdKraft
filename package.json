{
  "name": "krowdkraft-workshop",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run figures && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src tests scripts/*.mjs *.json *.ts *.mts",
    "check:http": "node scripts/check-http.mjs",
    "db:prepare": "node scripts/prepare-seed.mjs",
    "figures": "node scripts/build-computer.mjs && node scripts/build-printer.mjs && node scripts/build-hairline.mjs && node scripts/hairline/validate.mjs public/figures/hairline-pin-field.html",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "check:connections": "node --env-file=.env.local scripts/check-connections.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "^0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "^0.186.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
